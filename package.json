{
    "name": "electron-tetris",
    "version": "1.0.0",
    "description": "Electron Tetris",
    "main": "main.js",
    "scripts": {
        "pack": "electron-builder --dir",
        "dist": "electron-builder --publish never",
        "start": "electron ."
    },
    "build": {
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                }
            ]
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thesourorange/neilstuff/electron-tetris.git"
    },
    "keywords": [
        "Electron",
        "Game"
    ],
    "author": "GitHub",
    "license": "CC0-1.0",
    "dependencies": {
        "mime": "^3.0.0",
        "animatelo": "^1.0.3",
        "@fortawesome/fontawesome-free": "^5.13.0"
    },
    "devDependencies": {
        "electron": "^19.0.4",
        "electron-builder": "^23.0.3",
        "node": "^17.7.2"
    },
    "bugs": {
        "url": "https://github.com/thesourorange/neilstuff/electron-tetris"
    },
    "homepage": "https://github.com/thesourorange/neilstuff/mine-sweeper#readme"
}
